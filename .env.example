# Copie para .env e ajuste. Nunca versione o .env.

# Porta no host em que a API/UI ficam acessíveis (só em 127.0.0.1)
API_PORT=8088

# Modelo visual. Também é build arg: mudar exige `make build` e re-treino.
DINO_MODEL=facebook/dinov2-small
EMBED_SIZE=224
# auto | cpu | cuda
DEVICE=auto
# Permite baixar pesos em runtime se não estiverem na imagem (padrão: não)
ALLOW_MODEL_DOWNLOAD=false

# Resolução mínima da carta na foto (px/mm) para o veredito "real" ser possível
MIN_PX_PER_MM=12

# OCR e idioma dos rótulos/TCGdex: en | pt | es | fr | de
ENABLE_OCR=true
OCR_LANG=en

# Bases de referência
ENABLE_REFERENCE=true
TCG_API_KEY=
ENABLE_TCGDEX=true

# Ciclo de dados
STORE_INFERENCES=true
RETENTION_DAYS=180
MAX_INFERENCES_GB=5
# Se definido, POST /feedback exige o header X-Feedback-Token
FEEDBACK_TOKEN=

# API
MAX_CONCURRENT=2
QUEUE_TIMEOUT_S=30
MAX_UPLOAD_MB=15

# Limiares padrão (um run treinado pode trazer thresholds.json)
THRESHOLD_FAKE=0.65
THRESHOLD_REAL=0.35
